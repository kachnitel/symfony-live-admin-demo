{% extends 'base.html.twig' %}

{% block title %}Admin Bundle Demo{% endblock %}

{% block body %}
    {# Header with buttons #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Kachnitel\AdminBundle Demo</h1>
        <div class="flex flex-wrap gap-2">
            <a href="https://github.com/kachnitel/FrdAdminBundle" target="_blank"
               class="inline-flex items-center px-4 py-2 bg-gray-800 dark:bg-gray-700 text-white rounded-md hover:bg-gray-700 dark:hover:bg-gray-600 transition-colors text-sm">
                GitHub
            </a>
            <a href="https://github.com/kachnitel/FrdAdminBundle/blob/master/CHANGELOG.md" target="_blank"
               class="inline-flex items-center px-4 py-2 bg-gray-500 dark:bg-gray-600 text-white rounded-md hover:bg-gray-600 dark:hover:bg-gray-500 transition-colors text-sm">
                Changelog
            </a>
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <a href="{{ path('app_logout') }}"
                   class="inline-flex items-center px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-md hover:bg-red-700 dark:hover:bg-red-400 transition-colors text-sm">
                    Logout
                </a>
            {% else %}
                <a href="{{ path('app_login') }}"
                   class="inline-flex items-center px-4 py-2 bg-green-600 dark:bg-green-500 text-white rounded-md hover:bg-green-700 dark:hover:bg-green-400 transition-colors text-sm">
                    Login
                </a>
            {% endif %}
        </div>
    </div>

    {# About section #}
    <div class="mb-8 p-6 bg-gray-50 dark:bg-gray-800 border-l-4 border-blue-500 dark:border-blue-400 rounded-lg">
        <h2 class="text-xl font-bold text-blue-600 dark:text-blue-400 mb-2">About Kachnitel\AdminBundle</h2>
        <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
            A Symfony bundle for rapid admin interface development using <strong class="text-gray-900 dark:text-white">LiveComponents</strong>.
            Build fully functional CRUD interfaces with just PHP attributes — no boilerplate code required.
        </p>
    </div>

    {# Custom Controller Examples #}
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">Custom Controller Examples</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-6">
        These demonstrate using the bundle's components with custom routes and controllers:
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {% for entity in entities %}
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow dark:shadow-gray-900/50 hover:shadow-lg dark:hover:shadow-gray-900/70 transition-shadow">
                <h3 class="text-xl font-semibold text-blue-600 dark:text-blue-400 mb-2">{{ entity.name }}s</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
                    Custom route: <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">/custom-admin/{{ entity.name|lower }}</code>
                </p>
                {% if entity.name == 'User' %}
                    <p class="text-sm mt-2 {{ is_granted('IS_AUTHENTICATED_FULLY') ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' }}">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            Requires <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">ROLE_USER</code>
                        {% else %}
                            Requires <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">ROLE_USER</code> (login to access)
                        {% endif %}
                    </p>
                {% else %}
                    <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">No permission required (public)</p>
                {% endif %}
                <a href="{{ path(entity.route, {entity: entity.name|lower}) }}"
                   class="inline-block mt-4 px-4 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-md hover:bg-blue-700 dark:hover:bg-blue-400 transition-colors text-sm">
                    View {{ entity.name }}s
                </a>
            </div>
        {% endfor %}
    </div>

    {# Features Showcased #}
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">Features Showcased</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-6">
        This demo exercises the bundle's key features. Click through to the Bundle Admin to see them live.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">

        {# --- Inline Edit (NEW 0.6+) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50 border-l-4 border-green-500 dark:border-green-400">
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-green-600 dark:text-green-400">New in 0.6</span>
            </div>
            <strong class="text-gray-900 dark:text-white">Inline Edit</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Edit field values directly in the list view — no separate edit page needed.
                Validates on save using Symfony constraints.
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">enableInlineEdit: true</code>
            <br>
            <a href="{{ path('app_admin_entity_index', {entitySlug: 'bicycle'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-1 inline-block">
                See Bicycle list (brand/model/color/year editable) &rarr;
            </a>
        </div>

        {# --- Row Actions (NEW 0.7+) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50 border-l-4 border-green-500 dark:border-green-400">
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-green-600 dark:text-green-400">New in 0.7</span>
            </div>
            <strong class="text-gray-900 dark:text-white">Row Actions</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Add custom per-row buttons with conditions, confirmation dialogs,
                and custom routes. Appear on list rows, show, and edit pages.
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">#[AdminAction(name: 'duplicate', ...)]</code>
            <br>
            <a href="{{ path('app_admin_entity_index', {entitySlug: 'bicycle'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-1 inline-block">
                See Bicycle list (📋 Duplicate button) &rarr;
            </a>
        </div>

        {# --- Composite Columns (NEW 0.8+) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50 border-l-4 border-green-500 dark:border-green-400">
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-green-600 dark:text-green-400">New in 0.8</span>
            </div>
            <strong class="text-gray-900 dark:text-white">Composite Columns</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Group related properties into a single stacked table cell.
                Supports collapsible headers for per-sub-column sort/filter.
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">#[AdminColumn(group: 'bike')]</code>
            <br>
            <a href="{{ path('app_admin_entity_index', {entitySlug: 'bicycle'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-1 inline-block">
                See Bicycle list (Brand+Model in one cell) &rarr;
            </a>
        </div>

        {# --- Archive (NEW 0.8+) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50 border-l-4 border-green-500 dark:border-green-400">
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-green-600 dark:text-green-400">New in 0.8</span>
            </div>
            <strong class="text-gray-900 dark:text-white">Archive / Soft-Delete</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Show/hide archived rows with a toggle — no Doctrine filter needed.
                Archive and Unarchive buttons appear automatically.
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">archiveExpression: 'item.archived'</code>
            <br>
            <a href="{{ path('app_admin_entity_index', {entitySlug: 'part'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-1 inline-block">
                See Part list (toggle "Show archived") &rarr;
            </a>
        </div>

        {# --- Custom Columns (NEW 0.7+) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50 border-l-4 border-green-500 dark:border-green-400">
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-green-600 dark:text-green-400">New in 0.7</span>
            </div>
            <strong class="text-gray-900 dark:text-white">Custom Columns</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Add virtual, template-driven columns not backed by a Doctrine field.
                Perfect for computed values, badges, or enriched displays.
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">#[AdminCustomColumn(name: 'accountAge', ...)]</code>
            <br>
            <a href="{{ path('app_admin_entity_index', {entitySlug: 'user'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-1 inline-block">
                See User list ("Account Age" column) &rarr;
            </a>
        </div>

        {# --- Column Permissions (0.5) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">Column Permissions</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Role-based column visibility using Symfony's security voter
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">#[ColumnPermission([AdminEntityVoter::ADMIN_SHOW => 'ROLE_ADMIN'])]</code>
            <br>
            <span class="text-sm text-gray-500 dark:text-gray-500">User's lastLoginAt hidden for ROLE_USER</span>
        </div>

        {# --- Column Visibility (0.5) --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">Column Visibility Toggle</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Users can show/hide columns per entity, stored in session
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">enableColumnVisibility: true</code>
            <br>
            <span class="text-sm text-gray-500 dark:text-gray-500">Enabled on all entities</span>
        </div>

        {# --- Collection Filtering --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">Collection Filtering</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Filter by OneToMany/ManyToMany relations using EXISTS subqueries
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">#[ColumnFilter] on Collection</code>
            <br>
            <span class="text-sm text-gray-500 dark:text-gray-500">See Bicycle's parts filter</span>
        </div>

        {# --- Multi-Select Enum Filter --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">Multi-Select Enum Filter</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Select multiple enum values with IN operator
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">#[ColumnFilter(multiple: true)]</code>
            <br>
            <a href="{{ path('app_admin_datasource_index', {dataSourceId: 'vendor-catalog'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-1 inline-block">
                See Vendor Catalog's category filter &rarr;
            </a>
        </div>

        {# --- DataSource Abstraction --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">DataSource Abstraction</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Display non-Doctrine data sources (APIs, logs, etc.) using the same admin UI
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">implements DataSourceInterface</code>
            <br>
            <a href="{{ path('app_admin_datasource_index', {dataSourceId: 'vendor-catalog'}) }}"
               class="text-blue-600 dark:text-blue-400 hover:underline text-sm mt-2 inline-block">
                View Vendor Catalog demo &rarr;
            </a>
        </div>

        {# --- Batch Actions --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">Batch Actions</strong>
            <p class="text-sm text-gray-600 dark:text-gray:text-gray-400 my-2">
                Multi-select with Shift/Ctrl+Click, bulk delete
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">enableBatchActions: true</code>
            <br>
            <span class="text-sm text-gray-500 dark:text-gray-500">Enabled on all entities</span>
        </div>

        {# --- Entity URL Functions --- #}
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow dark:shadow-gray-900/50">
            <strong class="text-gray-900 dark:text-white">Entity URL Functions</strong>
            <p class="text-sm text-gray-600 dark:text-gray-400 my-2">
                Generate admin panel URLs for related entities in Twig
            </p>
            <code class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded text-gray-700 dark:text-gray-300">admin_entity_url() / admin_collection_url()</code>
            <br>
            <span class="text-sm text-gray-500 dark:text-gray-500">See Part's bike link, Bicycle's parts count</span>
        </div>

    </div>

    {# Quick Start section #}
    <div class="mb-8 p-6 bg-yellow-50 dark:bg-yellow-900/20 border-l-4 border-yellow-500 dark:border-yellow-400 rounded-lg">
        <h3 class="text-lg font-bold text-yellow-700 dark:text-yellow-400 mb-2">Quick Start</h3>
        <p class="text-gray-700 dark:text-gray-300 mb-2">Mark your entity with the <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">#[Admin]</code> attribute:</p>
        <pre class="bg-white dark:bg-gray-800 p-4 rounded-lg overflow-x-auto text-sm"><code class="text-gray-800 dark:text-gray-200">use Kachnitel\AdminBundle\Attribute\Admin;

#[Admin(
    icon: 'pedal_bike',
    enableInlineEdit: true,
    archiveExpression: 'item.archived',
    permissions: ['index' => 'ROLE_USER'],
)]
class Bicycle { ... }</code></pre>
        <p class="mt-3">
            <a href="https://github.com/kachnitel/FrdAdminBundle#readme" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline">
                View full documentation &rarr;
            </a>
        </p>
    </div>

    {# Security Features section #}
    <div class="mb-8 p-6 bg-green-50 dark:bg-green-900/20 border-l-4 border-green-500 dark:border-green-400 rounded-lg">
        <h3 class="text-lg font-bold text-green-700 dark:text-green-400 mb-2">Security Features</h3>
        <p class="text-gray-700 dark:text-gray-300 mb-2">Three levels of permission control:</p>
        <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-1 mb-4">
            <li><strong class="text-gray-900 dark:text-white">Global setting:</strong> <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">required_role: null</code> disables bundle-wide authentication</li>
            <li><strong class="text-gray-900 dark:text-white">Entity-level:</strong> <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">#[Admin(permissions: ['index' => 'ROLE_USER'])]</code> still enforced</li>
            <li><strong class="text-gray-900 dark:text-white">Column-level:</strong> <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">#[ColumnPermission([AdminEntityVoter::ADMIN_SHOW => 'ROLE_ADMIN'])]</code> hides columns per role</li>
            <li><strong class="text-gray-900 dark:text-white">Custom controller:</strong> Uses <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">AdminEntityVoter</code> to respect entity permissions</li>
        </ul>
        {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
            <p class="p-4 bg-white dark:bg-gray-800 rounded-lg text-gray-700 dark:text-gray-300">
                <strong class="text-gray-900 dark:text-white">Try it:</strong> Login with <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">user@example.com</code> / <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">password</code> to access User entity
            </p>
        {% else %}
            <p class="p-4 bg-white dark:bg-gray-800 rounded-lg text-gray-700 dark:text-gray-300">
                <strong class="text-gray-900 dark:text-white">Logged in</strong> — you can access User entity (requires <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">ROLE_USER</code>).
                Note: <em>lastLoginAt</em> column is hidden — it requires <code class="bg-gray-200 dark:bg-gray-700 px-1 rounded">ROLE_ADMIN</code>.
            </p>
        {% endif %}
    </div>
{% endblock %}
